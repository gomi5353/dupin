# SHACL rules of the Object Properties axis (rollout side; extends shapes/rollout.ttl).
#
# Severity:
#   sh:Violation - the rollout is malformed; the comparison stops

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

cp: a owl:Ontology ;
    sh:declare [ sh:prefix "cp" ; sh:namespace "http://taica.course/cp/ontology#"^^xsd:anyURI ] .

cp:ObjectPropertyRolloutShape a sh:NodeShape ;
    sh:targetClass cp:Rollout ;
    sh:sparql [
        sh:message "Finished run {?index} has no instruction, which the Object Properties axis compares (rollout log written by an older rollout.py?)" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index WHERE {
                $this cp:hasDataset ?dataset ; cp:hasRun ?run .
                ?run cp:index ?index .
                ?run cp:status ?s . FILTER (?s IN ("succeeded", "failed"))
                ?dataset cp:hasGeneralizationAxis ?axis .
                ?axis a cp:ObjectPropertyAxis .
                FILTER NOT EXISTS { ?run cp:taskDescription ?text . }
            }
        """ ;
    ] .
