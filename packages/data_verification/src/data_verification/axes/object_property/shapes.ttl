# SHACL rules of the Object Properties axis (dataset side; extends shapes/dataset.ttl).
#
# Severity:
#   sh:Violation - dataset fails verification (malformed data or spec)
#   sh:Warning   - reported, does not fail unless --strict
#
# Which reference an episode's task text uses, the per-reference counts and the
# unchanged-color check are computed in Python (coverage.py) and reported as
# findings.

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

cp: a owl:Ontology ;
    sh:declare [ sh:prefix "cp" ; sh:namespace "http://taica.course/cp/ontology#"^^xsd:anyURI ] .

# ---- Dataset: a color and a task text per episode ----------------------------

cp:ObjectPropertyDatasetShape a sh:NodeShape ;
    sh:targetClass cp:Dataset ;
    sh:sparql [
        sh:message "Episode {?index} has no color for required object '{?name}'" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index ?name WHERE {
                $this cp:hasEpisode ?episode ; cp:hasGeneralizationAxis ?axis .
                ?episode cp:index ?index .
                ?axis cp:hasRequirement ?req .
                ?req a cp:ColorReferenceRequirement ; cp:hasTaskObject ?reqObj .
                ?reqObj cp:name ?name .
                FILTER NOT EXISTS {
                    ?episode cp:hasObjectColor ?color .
                    ?color cp:name ?name .
                }
            }
        """ ;
    ] .

cp:ObjectPropertyTaskTextShape a sh:NodeShape ;
    sh:targetClass cp:Dataset ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Episode {?index} has no task text; it uses no reference" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index WHERE {
                $this cp:hasEpisode ?episode ; cp:hasGeneralizationAxis ?axis .
                ?axis a cp:ObjectPropertyAxis .
                ?episode cp:index ?index .
                FILTER NOT EXISTS { ?episode cp:taskDescription ?text . }
            }
        """ ;
    ] .

cp:ObjectColorShape a sh:NodeShape ;
    sh:targetClass cp:ObjectColor ;
    sh:property [ sh:path cp:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:colorR ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cp:colorG ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cp:colorB ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] .

# ---- Axis and requirement: well-formed spec ----------------------------------

cp:ObjectPropertyAxisShape a sh:NodeShape ;
    sh:targetClass cp:ObjectPropertyAxis ;
    sh:property [ sh:path cp:hasRequirement ; sh:class cp:ColorReferenceRequirement ; sh:minCount 1 ] .

cp:ColorReferenceRequirementShape a sh:NodeShape ;
    sh:targetClass cp:ColorReferenceRequirement ;
    sh:property [
        sh:path cp:hasTaskObject ; sh:class cp:TaskObject ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node cp:ReferenceTaskObjectShape ;
    ] ;
    sh:property [ sh:path cp:hasReference ; sh:class cp:ObjectReference ; sh:minCount 1 ] ;
    sh:property [ sh:path cp:minEpisodesPerReference ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [
        sh:path [ sh:inversePath cp:hasRequirement ] ; sh:maxCount 1 ;
        sh:message "Requirement is linked from more than one axis (cp:hasRequirement); give each axis its own requirement" ;
    ] ;
    sh:sparql [
        sh:message "Requirement is not linked from an ObjectPropertyAxis (cp:hasRequirement)" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?axis a cp:ObjectPropertyAxis ; cp:hasRequirement $this . }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Two references both use the phrase '{?phrase}'; give each reference its own phrase" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT DISTINCT $this ?phrase WHERE {
                $this cp:hasReference ?r1, ?r2 .
                ?r1 cp:phrase ?p1 . ?r2 cp:phrase ?p2 .
                FILTER (?r1 != ?r2 && LCASE(STR(?p1)) = LCASE(STR(?p2)))
                BIND (?p1 AS ?phrase)
            }
        """ ;
    ] .

# The factor is referencing objects by color: a requirement without a color
# reference checks the name form only.
cp:ColorReferencePresentShape a sh:NodeShape ;
    sh:targetClass cp:ColorReferenceRequirement ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Requirement has no cp:ColorReference; it only checks how often the object is referred to by name" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this cp:hasReference ?r . ?r a cp:ColorReference . }
            }
        """ ;
    ] .

cp:ObjectReferenceShape a sh:NodeShape ;
    sh:targetClass cp:ObjectReference ;
    sh:property [ sh:path cp:phrase ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
    sh:property [ sh:path cp:minEpisodesPerReference ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:sparql [
        sh:message "A reference must be a cp:NameReference or a cp:ColorReference" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this a ?kind . FILTER (?kind IN (cp:NameReference, cp:ColorReference)) }
            }
        """ ;
    ] .

cp:ReferenceTaskObjectShape a sh:NodeShape ;
    sh:property [ sh:path cp:name ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path cp:hasPosition ; sh:maxCount 0 ;
        sh:message "A requirement's task object names the object only; it has no position" ;
    ] .
