# SHACL rules of the Image Augmentations axis, factor lighting (dataset side; extends shapes/dataset.ttl).
#
# Severity:
#   sh:Violation - dataset fails verification (malformed data or spec)
#   sh:Warning   - reported, does not fail unless --strict
#
# The coverage rule itself (episodes per cell) is counted in Python
# (coverage.py) and reported as Violation findings.

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

cp: a owl:Ontology ;
    sh:declare [ sh:prefix "cp" ; sh:namespace "http://taica.course/cp/ontology#"^^xsd:anyURI ] .

# ---- Dataset: one light condition per required light -------------------------

cp:LightingDatasetShape a sh:NodeShape ;
    sh:targetClass cp:Dataset ;
    sh:sparql [
        sh:message "Episode {?index} has no lighting for required light '{?name}'" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index ?name WHERE {
                $this cp:hasEpisode ?episode ; cp:hasGeneralizationAxis ?axis .
                ?episode cp:index ?index .
                ?axis cp:hasRequirement ?req .
                ?req a cp:LightingRequirement ; cp:lightName ?name .
                FILTER NOT EXISTS {
                    ?episode cp:hasLightCondition ?light .
                    ?light cp:name ?name .
                }
            }
        """ ;
    ] .

cp:LightConditionShape a sh:NodeShape ;
    sh:targetClass cp:LightCondition ;
    sh:property [ sh:path cp:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:lightIntensity ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cp:colorTemperature ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] .

# ---- Axis and requirement: well-formed spec ----------------------------------

cp:LightingAxisShape a sh:NodeShape ;
    sh:targetClass cp:ImageAugmentationAxis ;
    sh:property [ sh:path cp:hasRequirement ; sh:class cp:LightingRequirement ; sh:minCount 1 ] .

cp:LightingAxisRequirementShape a sh:NodeShape ;
    sh:targetClass cp:LightingRequirement ;
    sh:property [ sh:path cp:lightName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:intensityMin ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cp:intensityMax ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:colorTemperatureMin ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cp:colorTemperatureMax ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:numBinsIntensity ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [ sh:path cp:numBinsColorTemperature ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [ sh:path cp:minEpisodesPerCell ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ] ;
    sh:property [
        sh:path [ sh:inversePath cp:hasRequirement ] ; sh:maxCount 1 ;
        sh:message "Requirement is linked from more than one axis (cp:hasRequirement); give each axis its own requirement" ;
    ] ;
    sh:sparql [
        sh:message "Requirement is not linked from a ImageAugmentationAxis (cp:hasRequirement)" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?axis a cp:ImageAugmentationAxis ; cp:hasRequirement $this . }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Lighting range is empty: intensityMin must be < intensityMax and colorTemperatureMin < colorTemperatureMax" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this WHERE {
                $this cp:intensityMin ?i0 ; cp:intensityMax ?i1 ; cp:colorTemperatureMin ?t0 ; cp:colorTemperatureMax ?t1 .
                FILTER (?i0 >= ?i1 || ?t0 >= ?t1)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "More than one lighting requirement for light '{?name}'; give each light one requirement" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT DISTINCT $this ?name WHERE {
                ?axis cp:hasRequirement $this, ?other .
                $this cp:lightName ?name . ?other a cp:LightingRequirement ; cp:lightName ?name .
                FILTER ($this != ?other)
            }
        """ ;
    ] .

# ---- Dataset vs ranges: allowed, but outside episodes do not count -----------

cp:LightingRangeShape a sh:NodeShape ;
    sh:targetClass cp:Dataset ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Episode {?index}: light '{?name}' at intensity {?i}, {?t} K is outside the required ranges; it does not count toward coverage" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index ?name ?i ?t WHERE {
                $this cp:hasGeneralizationAxis ?axis ; cp:hasEpisode ?episode .
                ?episode cp:index ?index ; cp:hasLightCondition ?light .
                ?axis cp:hasRequirement ?req .
                ?req a cp:LightingRequirement ; cp:lightName ?name ;
                     cp:intensityMin ?i0 ; cp:intensityMax ?i1 ; cp:colorTemperatureMin ?t0 ; cp:colorTemperatureMax ?t1 .
                ?light cp:name ?name ; cp:lightIntensity ?i ; cp:colorTemperature ?t .
                FILTER (?i < ?i0 || ?i > ?i1 || ?t < ?t0 || ?t > ?t1)
            }
        """ ;
    ] .
