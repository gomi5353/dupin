# SHACL rules of the Image Augmentations axis, factor lighting (rollout side; extends shapes/rollout.ttl).
#
# Severity:
#   sh:Violation - the rollout is malformed; the comparison stops

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

cp: a owl:Ontology ;
    sh:declare [ sh:prefix "cp" ; sh:namespace "http://taica.course/cp/ontology#"^^xsd:anyURI ] .

cp:LightingRolloutShape a sh:NodeShape ;
    sh:targetClass cp:Rollout ;
    sh:sparql [
        sh:message "Finished run {?index} has no lighting for '{?name}', which the training dataset's spec requires" ;
        sh:prefixes cp: ;
        sh:select """
            SELECT $this ?index ?name WHERE {
                $this cp:hasDataset ?dataset ; cp:hasRun ?run .
                ?run cp:index ?index .
                ?run cp:status ?s . FILTER (?s IN ("succeeded", "failed"))
                ?dataset cp:hasGeneralizationAxis ?axis .
                ?axis cp:hasRequirement ?req .
                ?req a cp:LightingRequirement ; cp:lightName ?name .
                FILTER NOT EXISTS {
                    ?run cp:hasLightCondition ?light .
                    ?light cp:name ?name .
                }
            }
        """ ;
    ] .
