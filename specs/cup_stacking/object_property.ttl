# Object Properties axis (STAR-Gen S-PROP), factor: referencing objects based
# on color.
#
# S-PROP changes only the task text, never the scene: "place the fork on the
# left ..." becomes "place the pink object on the left ...". The task
# configuration lists the phrases per object (object_references, e.g.
# {"name": "fork", "color": "pink object"}) and how often each form is used
# (reference_weights). The phrases below are already filled in: they are the
# wording of the evaluation, so leave them unchanged. Fill in every "TODO"
# (the minimum) in a copy of this file, then verify your dataset with it:
#
#   uv run python scripts/store.py verify --store stores/<repo_name> --spec <your copy>
#
# To check another axis in the same run, append its spec file after this one
# (--spec a.ttl b.ttl, the same as repeating --spec). Axes without a spec
# file are not checked.
#
# Each episode uses the reference whose phrase its task text contains (whole
# words, case-insensitive). The checks: every reference below is used by at
# least minEpisodesPerReference episodes (coverage), and each object's
# recorded color (object_color.<name>) is the same in every episode (S-PROP
# never changes the object).
#
# One block per object you want checked. Delete a block to stop checking that
# object; copy a block to check another one.
#
# Guide: docs/object_property.md

@prefix cp:   <http://taica.course/cp/ontology#> .
@prefix spec: <http://taica.course/cp/spec/mine#> .

# The Object Properties axis. Each block below adds one color reference requirement to it.
spec:object_property_axis a cp:ObjectPropertyAxis .

# --- BEGIN OBJECT ---
spec:object_property_axis cp:hasRequirement spec:blue_cup_reference_requirement .

spec:blue_cup_reference_requirement a cp:ColorReferenceRequirement ;
    cp:hasTaskObject spec:blue_cup_reference_object ;
    cp:hasReference spec:blue_cup_by_name , spec:blue_cup_by_color ;

    # Minimum number of episodes per reference (each reference below needs at
    # least this many to be "seen"). Whole number, e.g. 10. To give one
    # reference its own minimum, add cp:minEpisodesPerReference to it.
    cp:minEpisodesPerReference "TODO" .

spec:blue_cup_reference_object a cp:TaskObject ;
    # Must match the task configuration's object_references key and the
    # dataset column object_color.blue_cup.
    cp:name "blue_cup" .

# The phrase the task text uses when it refers to the object by its name
# (already filled in from the evaluation file; leave it unchanged):
# object_references["blue_cup"]["name"] in the task configuration.
spec:blue_cup_by_name a cp:NameReference ;
    cp:phrase "blue cup" .

# The phrase the task text uses when it refers to the object by its color
# (already filled in from the evaluation file; leave it unchanged):
# object_references["blue_cup"]["color"] in the task configuration.
spec:blue_cup_by_color a cp:ColorReference ;
    cp:phrase "blue object" .
# --- END OBJECT ---

# --- BEGIN OBJECT ---
spec:object_property_axis cp:hasRequirement spec:pink_cup_reference_requirement .

spec:pink_cup_reference_requirement a cp:ColorReferenceRequirement ;
    cp:hasTaskObject spec:pink_cup_reference_object ;
    cp:hasReference spec:pink_cup_by_name , spec:pink_cup_by_color ;

    # Minimum number of episodes per reference (each reference below needs at
    # least this many to be "seen"). Whole number, e.g. 10. To give one
    # reference its own minimum, add cp:minEpisodesPerReference to it.
    cp:minEpisodesPerReference "TODO" .

spec:pink_cup_reference_object a cp:TaskObject ;
    # Must match the task configuration's object_references key and the
    # dataset column object_color.pink_cup.
    cp:name "pink_cup" .

# The phrase the task text uses when it refers to the object by its name
# (already filled in from the evaluation file; leave it unchanged):
# object_references["pink_cup"]["name"] in the task configuration.
spec:pink_cup_by_name a cp:NameReference ;
    cp:phrase "pink cup" .

# The phrase the task text uses when it refers to the object by its color
# (already filled in from the evaluation file; leave it unchanged):
# object_references["pink_cup"]["color"] in the task configuration.
spec:pink_cup_by_color a cp:ColorReference ;
    cp:phrase "pink object" .
# --- END OBJECT ---
